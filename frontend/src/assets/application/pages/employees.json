{
  "title": "Employees",
  "store": "employees",
  "getAllDataInColumnFilterApi": "/api/employees/filter-options",
  "tableList": [
    {
      "name": "actions",
      "label": "Actions",
      "pipe": "actions",
      "style": { "position": "sticky", "left": 0, "z-index": 2, "background-color": "var(--surface)" }
    },
    { "name": "fullName", "label": "Name", "pipe": "employeeIdentity", "columnFilter": true, "getAllDataInColFilter": true },
    { "name": "employeeCode", "label": "Employee code", "columnFilter": true, "getAllDataInColFilter": true },
    { "name": "email", "label": "Email", "columnFilter": true, "getAllDataInColFilter": true },
    { "name": "department", "label": "Department", "columnFilter": true, "getAllDataInColFilter": true },
    { "name": "jobTitle", "label": "Job title", "columnFilter": true, "getAllDataInColFilter": true },
    { "name": "countryCode", "label": "Country", "columnFilter": true },
    { "name": "currencyCode", "label": "Currency", "columnFilter": true },
    { "name": "annualGrossBaseSalary", "label": "Annual gross base salary", "pipe": "salaryAmount", "columnFilter": true, "showDataRange": true },
    { "name": "status", "label": "Status", "pipe": "status", "columnFilter": true }
  ],
  "steps": [
    {
      "stepName": "employee",
      "label": "Employee details",
      "index": 0,
      "status": true,
      "fields": [
        { "name": "employeeCode", "label": "Employee code", "type": "input", "inputType": "text", "validation": { "required": true, "maxLength": 20 } },
        { "name": "firstName", "label": "First name", "type": "input", "inputType": "text", "validation": { "required": true, "maxLength": 80 } },
        { "name": "lastName", "label": "Last name", "type": "input", "inputType": "text", "validation": { "required": true, "maxLength": 80 } },
        { "name": "email", "label": "Email", "type": "input", "inputType": "email", "validation": { "required": true, "maxLength": 255 } },
        { "name": "department", "label": "Department", "type": "input", "inputType": "text", "validation": { "required": true, "maxLength": 100 } },
        { "name": "jobTitle", "label": "Job title", "type": "input", "inputType": "text", "validation": { "required": true, "maxLength": 100 } },
        { "name": "countryCode", "label": "Country", "type": "select", "validation": { "required": true } },
        { "name": "annualGrossBaseSalary", "label": "Annual gross base salary", "type": "input", "inputType": "text", "validation": { "required": true, "maxLength": 19 } }
      ]
    }
  ],
  "lists": {
    "countryCode": [
      { "value": "FR", "label": "France", "currencyCode": "EUR" },
      { "value": "DE", "label": "Germany", "currencyCode": "EUR" },
      { "value": "IN", "label": "India", "currencyCode": "INR" },
      { "value": "SG", "label": "Singapore", "currencyCode": "SGD" },
      { "value": "GB", "label": "United Kingdom", "currencyCode": "GBP" },
      { "value": "US", "label": "United States", "currencyCode": "USD" }
    ]
  }
}
