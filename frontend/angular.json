{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "cache": { "enabled": false }, "analytics": false },
  "projects": {
    "salary-management": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.json",
            "outputPath": "dist",
            "styles": ["src/styles.css"],
            "assets": [
              "src/favicon.svg",
              { "glob": "**/*", "input": ".taomish/src/lib/assets", "output": "assets" }
            ],
            "optimization": false,
            "preserveSymlinks": true,
            "sourceMap": false
          },
          "configurations": {
            "production": { "optimization": true, "outputHashing": "all" }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "buildTarget": "salary-management:build" }
        }
      }
    }
  }
}
